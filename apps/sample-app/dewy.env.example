# =============================================================================
# Dewy configuration for sample-app
# =============================================================================
# Copy this file and adjust values for each application.
# This file is read by the systemd unit as EnvironmentFile=
# DO NOT commit secrets — use a secrets manager or inject at deploy time.
# =============================================================================

# --- Registry ---
# OCI image to poll. Supports GHCR, ECR, GAR, Docker Hub, or self-hosted.
DEWY_REGISTRY=img://ghcr.io/your-org/sample-app

# --- Network ---
DEWY_PORT=8080
DEWY_HEALTH_PATH=/health

# --- Deployment ---
# Number of container replicas to run on this node.
DEWY_REPLICAS=2

# --- Lifecycle hooks ---
DEWY_BEFORE_DEPLOY_HOOK=./backup/hooks/before-deploy.sh
DEWY_AFTER_DEPLOY_HOOK=./backup/hooks/after-deploy.sh

# --- Notifications ---
# Slack: slack://channel-name?title=app-name
# SMTP:  smtp://user:pass@host:port?to=ops@example.com
DEWY_NOTIFIER=slack://your-channel?title=sample-app

# --- Extra docker run arguments ---
# Passed to Dewy after the -- separator, forwarded directly to docker run.
# Add mounts, resource limits, environment variables, etc.
#
# App-specific environment variables should be stored in a separate app.env
# file (gitignored) and loaded via --env-file to keep secrets out of this file.
# Ansible will automatically copy app.env to the VM if it exists.
#
# Example:
#   app.env        ← create from app.env.example, fill in secrets
#   DEWY_EXTRA_ARGS="--env-file /opt/3ds/apps/sample-app/app.env --memory 512m --cpus 1"
DEWY_EXTRA_ARGS="-v app-data:/data --memory 512m --cpus 1"
